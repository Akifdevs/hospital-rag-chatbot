HF_TOKEN=your_huggingface_token_here
# LLM Provider: OpenAI or Groq (dynamically supported; switch without code changes)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
# GROQ_API_KEY=your_groq_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=service_rag
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=service_rag
# Optional: use this instead of the MYSQL_* values.
# DATABASE_URL=mysql+pymysql://service_rag:change-me@127.0.0.1:3306/service_rag
# Used only by scripts/migrate_sqlite_to_mysql.py.
# SQLITE_SOURCE_PATH=data/rag.db

# Dynamic Role-Based Access Control (RBAC)
RAG_DEFAULT_ROLE=receptionist
RAG_ROLE_CACHE_TTL_SECONDS=60
